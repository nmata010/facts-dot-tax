        <Boolean/>
      </Writable>
    </Fact>

    <Fact path="/schEPropertyTypeOptions">
      <Derived>
        <EnumOptions>
          <String>singleFamilyResidence</String>
          <String>multiFamilyResidence</String>
          <String>vacationShortTermRental</String>
          <String>commercial</String>
          <String>land</String>
          <String>royalties</String>
          <String>selfRental</String>
          <String>other</String>
        </EnumOptions>
      </Derived>
    </Fact>

    <Fact path="/schEPropertyType">
      <Form>Schedule E</Form>
      <Line>1b</Line>
      <Name>Type of property</Name>
      <Description>Schedule E line 1b. Type of property from list (1-8).</Description>
      <Writable>
        <Enum optionsPath="/schEPropertyTypeOptions"/>
      </Writable>
    </Fact>

    <Fact path="/schEIsRoyaltyProperty">
      <Name>Is royalty property</Name>
      <Description>Schedule E helper. True if property type is royalties (type 6).</Description>
      <Derived>
        <Equal>
          <Left><Dependency path="/schEPropertyType" /></Left>
          <Right><Enum optionsPath="/schEPropertyTypeOptions">royalties</Enum></Right>
        </Equal>
      </Derived>
    </Fact>

