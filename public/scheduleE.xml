    <Fact path="/schETotalRents">
      <Form>Schedule E</Form>
      <Line>23a</Line>
      <Name>Total rents for all rental properties</Name>
      <Description>Schedule E line 23a. Total of all amounts reported on line 3 for all rental properties.</Description>
      <Derived>
        <Switch>
          <Case>
            <When><Dependency path="/schEIsRoyaltyProperty" /></When>
            <Then><Dollar>0</Dollar></Then>
          </Case>
          <Case>
            <When><True/></When>
            <Then><Dependency path="/schERentsReceived" /></Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/schETotalRoyalties">
      <Form>Schedule E</Form>
      <Line>23b</Line>
      <Name>Total royalties for all royalty properties</Name>
      <Description>Schedule E line 23b. Total of all amounts reported on line 4 for all royalty properties.</Description>
      <Derived>
        <Switch>
          <Case>
            <When><Dependency path="/schEIsRoyaltyProperty" /></When>
            <Then><Dependency path="/schERoyaltiesReceived" /></Then>
          </Case>
          <Case>
            <When><True/></When>
            <Then><Dollar>0</Dollar></Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

