    <Fact path="/schEGrossRentalIncome">
      <Name>Gross rental income</Name>
      <Description>Schedule E helper. Rents received plus royalties received.</Description>
      <Derived>
        <Add>
          <Dependency path="/schERentsReceived" />
          <Dependency path="/schERoyaltiesReceived" />
        </Add>
      </Derived>
    </Fact>

    <Fact path="/schENetIncomeOrLoss">
      <Form>Schedule E</Form>
      <Line>21</Line>
      <Name>Net rental income or loss</Name>
      <Description>Schedule E line 21. Subtract line 20 from line 3 (rents) and/or 4 (royalties).</Description>
      <Derived>
        <Subtract>
          <Minuend><Dependency path="/schEGrossRentalIncome" /></Minuend>
          <Subtrahends><Dependency path="/schETotalExpenses" /></Subtrahends>
        </Subtract>
      </Derived>
    </Fact>

