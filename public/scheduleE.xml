    <Fact path="/schETotalExpenses">
      <Form>Schedule E</Form>
      <Line>20</Line>
      <Name>Total expenses</Name>
      <Description>Schedule E line 20. Add lines 5 through 19.</Description>
      <Derived>
        <Add>
          <Dependency path="/schEAdvertising" />
          <Dependency path="/schEAutoAndTravel" />
          <Dependency path="/schECleaningAndMaintenance" />
          <Dependency path="/schECommissions" />
          <Dependency path="/schEInsurance" />
          <Dependency path="/schELegalAndProfessionalFees" />
          <Dependency path="/schEManagementFees" />
          <Dependency path="/schEMortgageInterest" />
          <Dependency path="/schEOtherInterest" />
          <Dependency path="/schERepairs" />
          <Dependency path="/schESupplies" />
          <Dependency path="/schETaxes" />
          <Dependency path="/schEUtilities" />
          <Dependency path="/schEDepreciation" />
          <Dependency path="/schEOtherExpenses" />
        </Add>
      </Derived>
