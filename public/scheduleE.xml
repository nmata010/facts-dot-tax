    <Fact path="/schEIncome">
      <Form>Schedule E</Form>
      <Line>24</Line>
      <Name>Income</Name>
      <Description>Schedule E line 24. Add positive amounts shown on line 21. Do not include any losses.</Description>
      <Derived>
        <GreaterOf>
          <Dependency path="/schENetIncomeOrLoss" />
          <Dollar>0</Dollar>
        </GreaterOf>
      </Derived>
    </Fact>

    <Fact path="/schELosses">
      <Form>Schedule E</Form>
      <Line>25</Line>
      <Name>Losses</Name>
      <Description>Schedule E line 25. Add royalty losses from line 21 and rental real estate losses from line 22.</Description>
      <Derived>
        <Switch>
          <Case>
            <When><Dependency path="/schEIsRoyaltyProperty" /></When>
            <Then>
              <LesserOf>
                <Dependency path="/schENetIncomeOrLoss" />
                <Dollar>0</Dollar>
              </LesserOf>
            </Then>
          </Case>
          <Case>
            <When><True/></When>
            <Then>
              <Subtract>
                <Minuend><Dollar>0</Dollar></Minuend>
                <Subtrahends><Dependency path="/schEDeductibleLoss" /></Subtrahends>
              </Subtract>
            </Then>
          </Case>
        </Switch>
      </Derived>
    </Fact>

    <Fact path="/schETotalRentalAndRoyalty">
      <Form>Schedule E</Form>
      <Line>26</Line>
      <Name>Total rental real estate and royalty income or loss</Name>
      <Description>Schedule E line 26. Combine lines 24 and 25.</Description>
      <Derived>
        <Add>
          <Dependency path="/schEIncome" />
          <Dependency path="/schELosses" />
        </Add>
      </Derived>
    </Fact>

